---
import { publicMusicVideo } from "../lib/content.js";

interface Props {
  track: any;
}

const { track } = Astro.props;
const video = publicMusicVideo(track);
const headingId = `music-video-${track.slug}`;
---
{video && (
  <section class="music-video-player" aria-labelledby={headingId}>
    <p class="eyebrow">Official visual</p>
    <h2 id={headingId}>{track.title} music video</h2>
    <video controls preload="metadata" poster={video.poster} playsinline>
      <source src={video.publicUrl} type="video/mp4" />
      Your browser does not support embedded video.
      <a href={video.publicUrl}>Watch {track.title}</a>.
    </video>
  </section>
)}

<style>
  .music-video-player {
    display: grid;
    gap: 14px;
    width: min(100% - clamp(40px, 8vw, 112px), 1200px);
    margin: 0 auto clamp(32px, 5vw, 64px);
    padding: clamp(22px, 4vw, 40px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 10px 28px rgba(23, 23, 23, 0.08);
    text-align: center;
  }

  .music-video-player h2,
  .music-video-player p {
    margin: 0;
  }

  .music-video-player video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    background: #000;
  }
</style>

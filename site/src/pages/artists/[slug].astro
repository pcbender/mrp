---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArtistReleaseList from "../../components/ArtistReleaseList.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StreamingLinks from "../../components/StreamingLinks.astro";
import { getArtistById, getArtists, artistMembers, getVisibleReleases } from "../../lib/content.js";
import { artistStreamingLinks, releasesForArtist } from "../../lib/catalog";

export function getStaticPaths() {
  return getArtists().map((artist) => ({ params: { slug: artist.id } }));
}

const artist = getArtistById(Astro.params.slug);
const releases = releasesForArtist(artist.id);
const links = artistStreamingLinks(artist);
const members = artistMembers(artist);

const sameAs = Object.values(artist.links || {}).filter(Boolean);
const artistJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "name": artist.name,
  "url": `https://www.maricoparecords.com/artists/${artist.id}/`,
  ...(artist.image ? { "image": `https://www.maricoparecords.com${artist.image}` } : {}),
  ...(artist.bio_short ? { "description": artist.bio_short } : {}),
  ...(sameAs.length ? { "sameAs": sameAs } : {})
});
const visibleReleaseSlugs = new Set(getVisibleReleases().map((release) => release.slug));

// A blurb is written while its release is still a draft, so it can name a release
// whose page the build won't emit yet. Keep the link text and drop the anchor
// rather than shipping a dead href; it becomes a link once the release goes live.
function isLinkableHref(href: string): boolean {
  const releaseMatch = /^\/releases\/([^/]+)\//.exec(href);
  return releaseMatch ? visibleReleaseSlugs.has(releaseMatch[1]) : true;
}

function renderPromoMarkdown(text: string): string {
  return text
    // A generated blurb sometimes doubles a bracket ('["Them Bones"]](/releases/...)'),
    // which stops the link regex below from matching and ships raw markdown.
    .replace(/\[{2,}/g, "[")
    .replace(/\]{2,}\(/g, "](")
    .replace(/\*([^*]+)\*/g, "<em>$1</em>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label, href) =>
      isLinkableHref(href) ? `<a href="${href}">${label}</a>` : label
    )
    .replace(/\s+([,.;:!?])/g, "$1")
    .replace(/\s+/g, " ")
    .trim();
}

// Promoter prose reaches us with mixed line endings: some bios separate their
// paragraphs with "\n\r\n", which a bare /\n{2,}/ split runs together into one
// wall of text. Normalise first, then split on blank lines.
function proseBlocks(text: string) {
  return String(text || "")
    .replace(/\r\n?/g, "\n")
    .split("## Releases")[0]
    .split(/\n{2,}/)
    .map((block) => block.trim())
    .filter(Boolean)
    .filter((block) => block !== `## ${artist.name}`)
    .map((block) => {
      if (block.startsWith("## ")) {
        return { tag: "h2", text: cleanMarkdownText(block.slice(3)) };
      }
      if (block.startsWith("### ")) {
        return { tag: "h3", text: cleanMarkdownText(block.slice(4)) };
      }
      return { tag: "p", html: renderPromoMarkdown(block.replace(/\n+/g, " ")) };
    });
}

// The blurb is the current pitch, the long bio the evergreen statement. When
// both exist the blurb leads and the bio becomes the "More..." section at the
// foot of the page; with no blurb the bio moves up and takes its place.
const bioBlocks = proseBlocks(artist.promo_blurb || artist.bio_long || "");
const biographyBlocks = artist.promo_blurb ? proseBlocks(artist.bio_long || "") : [];

function cleanMarkdownText(value: string) {
  return String(value)
    .replace(/\*\*([^*]+)\*\*/g, "$1")
    .replace(/__([^_]+)__/g, "$1")
    .replace(/\*([^*]+)\*/g, "$1")
    .replace(/_([^_]+)_/g, "$1")
    .replace(/\s+([,.;:!?])/g, "$1")
    .replace(/\s+/g, " ")
    .trim();
}

---
<BaseLayout paneled={true} title={`${artist.name} | Maricopa Records`} description={artist.bio_short || `${artist.name} on Maricopa Records.`} ogType="profile" ogImage={artist.image}>
  <script type="application/ld+json" slot="head" set:html={artistJsonLd} />
  <header class="artist-hero" style={`--artist-hero-image: url("${artist.image || "/assets/maricopa-mark.svg"}")`}>
    <h1>{artist.name}</h1>
    <Breadcrumbs items={[
      { label: "Artists", href: "/artists/" },
      { label: artist.name },
    ]} />
  </header>

  <section class="artist-profile-card">
    <div>
      <p class="eyebrow">Artist</p>
      <h1>{artist.name}</h1>
      {bioBlocks.map((block) =>
        "html" in block
          ? <p set:html={block.html} />
          : block.tag === "h2" ? <h2>{block.text}</h2> : <h3>{block.text}</h3>
      )}
      {biographyBlocks.length > 0 && (
        <a class="bio-more" href="#biography">More...</a>
      )}
      <StreamingLinks links={links} />
    </div>
    <img src={artist.image || "/assets/maricopa-mark.svg"} alt={artist.name} width="320" height="320" />
  </section>
  {members.length > 0 && (
    <section class="member-list">
      <div class="section-heading">
        <p class="eyebrow">Members</p>
        <h2>Band members</h2>
      </div>
      <ul>
        {members.map((member) => (
          <li class="member-card">
            <img
              src={member.image || "/assets/maricopa-mark.svg"}
              alt={member.name}
              width="160"
              height="160"
              loading="lazy"
            />
            <div class="member-info">
              <h3>{member.name}</h3>
              {member.roles?.length > 0 && <p class="member-roles">{member.roles.join(", ")}</p>}
              {member.bio && String(member.bio).split(/\n{2,}/).map((para) => (
                <p class="member-bio">{para.trim()}</p>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <ArtistReleaseList artistName={artist.name} releases={releases} />

  {biographyBlocks.length > 0 && (
    <section class="artist-biography" id="biography">
      <p class="eyebrow">Biography</p>
      <h2>About {artist.name}</h2>
      {biographyBlocks.map((block) =>
        "html" in block
          ? <p set:html={block.html} />
          : block.tag === "h2" ? <h3>{block.text}</h3> : <h4>{block.text}</h4>
      )}
    </section>
  )}
</BaseLayout>

<style>
  .artist-hero,
  .content-hero {
    min-height: 150px;
    display: grid;
    place-items: center;
    padding: clamp(24px, 4vw, 44px) clamp(20px, 4vw, 56px);
    color: #ffffff;
    text-align: center;
    background:
      linear-gradient(rgba(17, 17, 17, 0.5), rgba(17, 17, 17, 0.58)),
      var(--artist-hero-image, var(--content-hero-image)),
      var(--green);
    background-position: center 38%;
    background-size: cover;
  }

  .artist-hero h1,
  .content-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  .artist-hero :global(.breadcrumbs),
  .content-hero :global(.breadcrumbs) {
    color: rgba(255, 255, 255, 0.78);
  }

  .artist-hero :global(.breadcrumbs li + li::before),
  .content-hero :global(.breadcrumbs li + li::before) {
    color: rgba(255, 255, 255, 0.45);
  }

  .artist-profile-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: clamp(26px, 4vw, 52px);
    align-items: center;
    width: min(100% - clamp(40px, 8vw, 112px), 980px);
    margin: clamp(24px, 4vw, 48px) auto;
    padding: clamp(22px, 4vw, 36px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 10px 28px rgba(23, 23, 23, 0.08);
  }

  .artist-profile-card > div {
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
  }

  .artist-profile-card h1,
  .artist-profile-card h2,
  .artist-profile-card h3,
  .artist-profile-card p {
    margin: 0;
  }

  .artist-profile-card h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .artist-profile-card h2,
  .artist-profile-card h3 {
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .artist-profile-card p {
    color: var(--muted);
  }

  .artist-profile-card > img {
    width: 100%;
    height: auto;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--panel);
  }

  @media (max-width: 760px) {
    .artist-profile-card {
      grid-template-columns: 1fr;
    }

    .artist-profile-card > div {
      justify-items: start;
      text-align: left;
    }
  }

  /* Matches the "More..." affordance on the release and artist cards. */
  .bio-more {
    justify-self: end;
    color: #455fd6;
    font-size: 0.86rem;
    font-style: italic;
    text-decoration: none;
  }

  .bio-more:hover {
    text-decoration: underline;
  }

  .artist-biography {
    display: grid;
    gap: 16px;
    width: min(100% - clamp(40px, 8vw, 112px), 760px);
    margin: 0 auto;
    padding: clamp(20px, 4vw, 42px) 0 clamp(42px, 7vw, 84px);
    scroll-margin-top: 24px;
  }

  .artist-biography h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1.15;
  }

  .artist-biography h3,
  .artist-biography h4 {
    margin: 8px 0 0;
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .artist-biography p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .member-list {
    display: grid;
    gap: 28px;
    width: min(100% - clamp(40px, 8vw, 112px), 980px);
    margin: 0 auto;
    padding: clamp(20px, 4vw, 42px) 0 clamp(42px, 7vw, 84px);
  }

  .member-list ul {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member-card {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .member-card > img {
    width: 96px;
    height: 96px;
    border: 1px solid var(--line);
    border-radius: 4px;
    object-fit: cover;
    background: var(--panel);
  }

  .member-info {
    display: grid;
    gap: 6px;
  }

  .member-info h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .member-roles {
    margin: 0;
    color: var(--red);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .member-bio {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .member-card {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maricoparecords.local/mrp/release.schema.json",
  "title": "MRP Release Record",
  "type": "object",
  "required": ["release"],
  "additionalProperties": false,
  "properties": {
    "release": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "artist_id",
        "model",
        "release_type",
        "status",
        "release_date",
        "cover_image",
        "seo"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "title_ascii": {"type": "string", "minLength": 1},
        "artist_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "model": {"type": "string", "enum": ["song", "album"]},
        "release_type": {"type": "string", "enum": ["single", "ep", "album"]},
        "status": {
          "type": "string",
          "enum": ["draft", "staged", "verified", "approved", "live", "failed", "archived"]
        },
        "release_date": {"type": ["string", "null"], "format": "date"},
        "label": {"type": ["string", "null"]},
        "publisher": {"type": ["string", "null"]},
        "distributor": {"type": ["string", "null"]},
        "upc": {"type": ["string", "null"]},
        "catalog_number": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "copyright": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "composition_owner": {"type": ["string", "null"]},
            "composition_year": {"type": ["integer", "null"]},
            "recording_owner": {"type": ["string", "null"]},
            "recording_year": {"type": ["integer", "null"]}
          }
        },
        "cover_image": {"type": "string", "minLength": 1},
        "hero_image": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "credits": {"$ref": "#/$defs/credits"},
        "featuring": {"$ref": "#/$defs/featuring"},
        "links": {"$ref": "#/$defs/links"},
        "seo": {
          "type": "object",
          "required": ["title", "description"],
          "additionalProperties": false,
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "song": {"$ref": "#/$defs/track"},
        "tracks": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/track"}
        },
        "promoter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "promo_track_slug": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow_auto_publish": {"type": "boolean"},
            "master_path": {"type": ["string", "null"]},
            "links_na": {"type": "array", "items": {"type": "string"}}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"model": {"const": "song"}}, "required": ["model"]},
          "then": {
            "required": ["song"],
            "properties": {"release_type": {"const": "single"}},
            "not": {
              "anyOf": [
                {"required": ["tracks"]},
                {"required": ["promoter"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"model": {"const": "album"}}, "required": ["model"]},
          "then": {
            "required": ["tracks"],
            "properties": {"release_type": {"enum": ["ep", "album"]}},
            "not": {"required": ["song"]}
          }
        }
      ]
    }
  },
  "$defs": {
    "stem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "label": {"type": ["string", "null"]},
        "role": {
          "type": "string",
          "enum": ["drums", "bass", "vocals", "instruments", "other"]
        },
        "path": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"}
      }
    },
    "public_media_reference": {
      "oneOf": [
        {"type": "string", "minLength": 1, "pattern": "^(?:https?://|/media/)"},
        {"type": "null"}
      ]
    },
    "music_video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "status"],
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^assets/source/video/[a-z0-9][a-z0-9-]*--[a-z0-9][a-z0-9-]*/project\\.yaml$"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "timed", "cast", "previewed", "rendered", "approved", "published"]
        },
        "opt_in": {"type": "boolean"},
        "public_url": {"$ref": "#/$defs/public_media_reference"},
        "poster": {"$ref": "#/$defs/public_media_reference"}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "published"}}
          },
          "then": {
            "required": ["public_url", "poster"],
            "properties": {
              "public_url": {"type": "string", "minLength": 1},
              "poster": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "required": ["opt_in"],
            "properties": {"opt_in": {"const": true}}
          },
          "then": {
            "required": ["public_url", "poster"],
            "properties": {
              "status": {"const": "published"},
              "public_url": {"type": "string", "minLength": 1},
              "poster": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "featuring": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "performer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "member": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "artist": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "role": {"type": "string", "minLength": 1},
        "note": {"type": ["string", "null"]}
      },
      "oneOf": [
        {"required": ["member"], "not": {"required": ["artist"]}},
        {"required": ["artist"], "not": {"required": ["member"]}}
      ]
    },
    "credits": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]},
      "properties": {
        "primary_artist": {"type": ["string", "null"]},
        "songwriter": {"type": ["string", "null"]},
        "lyrics": {"type": ["string", "null"]},
        "producer": {"type": ["string", "null"]},
        "mastering": {"type": ["string", "null"]}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]},
      "properties": {
        "spotify": {"type": ["string", "null"]},
        "apple_music": {"type": ["string", "null"]},
        "youtube_music": {"type": ["string", "null"]},
        "bandcamp": {"type": ["string", "null"]},
        "soundcloud": {"type": ["string", "null"]},
        "itunes_store": {"type": ["string", "null"]}
      }
    },
    "track": {
      "type": "object",
      "required": ["title", "slug", "explicit", "instrumental"],
      "additionalProperties": false,
      "properties": {
        "number": {"type": ["integer", "null"], "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "isrc": {"type": ["string", "null"]},
        "duration": {"type": ["string", "null"]},
        "explicit": {"type": "boolean"},
        "instrumental": {"type": "boolean"},
        "preview_audio": {"type": ["string", "null"]},
        "lyrics_text": {"type": ["string", "null"]},
        "lyrics_raw": {"type": ["string", "null"]},
        "lyrics_source": {"type": ["string", "null"]},
        "section_tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "style": {"type": ["string", "null"]},
        "master_path": {"type": ["string", "null"]},
        "stems": {
          "type": "array",
          "items": {"$ref": "#/$defs/stem"}
        },
        "music_video": {"$ref": "#/$defs/music_video"},
        "credits": {"$ref": "#/$defs/credits"},
        "featuring": {"$ref": "#/$defs/featuring"},
        "performers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/performer"}
        },
        "links": {"$ref": "#/$defs/links"},
        "hints": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "critic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string"},
            "persona": {"type": "string"},
            "target": {"type": "string"},
            "target_tier": {"type": ["integer", "null"]}
          }
        }
      }
    }
  }
}
